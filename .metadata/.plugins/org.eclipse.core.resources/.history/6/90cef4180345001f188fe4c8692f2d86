package strings;

	public class Fortmat{  
		public static void main(String args[]){  
		String name="sonoo";  
		String sf1=String.format("name is %s",name);  
		String sf2=String.format("value is %f",32.33434);  
		String sf3=String.format("value is %32.12f",32.33434);
		System.out.println(sf1);  
		System.out.println(sf2);  
		System.out.println(sf3);  
	// formating  width, padding etc of any value
		String str = String.format("|%5d|",10);
		String str1 = String.format("|%-10s|","Yadnyesh");
		String str2 = String.format("|%35d|",10);
		System.out.println(str);
		System.out.println(str1);
		System.out.println(str2);
		}
}
