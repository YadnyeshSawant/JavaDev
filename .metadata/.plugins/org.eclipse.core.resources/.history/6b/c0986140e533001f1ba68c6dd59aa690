package Polymorphism;
import java.util.Scanner;

abstract class TestBankAccount {
    protected double balance = 20000;
    protected double amount;
    protected Scanner sc = new Scanner(System.in);

    void deposit() {
        System.out.println("Enter Amount to Deposit:");
        amount = sc.nextDouble();
        balance += amount;
    }

    abstract void withdraw(); // Making withdraw abstract to enforce overriding

    double checkBalance() {
        return balance;
    }
}

class TestSavingsAccount extends TestBankAccount {

    @Override
    void withdraw() {
        System.out.println("Enter Amount to Withdraw:");
        amount = sc.nextDouble();
        if (balance - amount >= 1000) {
            balance -= amount;
            System.out.println("Amount withdrawn: " + amount);
        } else {
            System.out.println("Insufficient Balance. Savings Account must maintain a minimum balance of 1000.");
        }
    }
}

class CheckingAccount extends BankAccount {

    @Override
    void withdraw() {
        System.out.println("Enter Amount to Withdraw:");
        amount = sc.nextDouble();
        if (balance >= amount) {
            balance -= amount;
            System.out.println("Amount withdrawn: " + amount);
        } else {
            System.out.println("Insufficient Balance.");
        }
    }
}

public class BankGPT {

    public static void main(String[] args) {
        BankAccount savingsAccount = new SavingsAccount();
        BankAccount checkingAccount = new CheckingAccount();
        Scanner sc = new Scanner(System.in);
        int choice;

        while (true) {
            System.out.println("1: Savings Account\n2: Checking Account\n3: Exit");
            System.out.println("Enter your choice:");
            choice = sc.nextInt();

            switch (choice) {
                case 1:
                    manageAccount(savingsAccount);
                    break;
                case 2:
                    manageAccount(checkingAccount);
                    break;
                case 3:
                    System.out.println("Exiting...");
                    sc.close();
                    return;
                default:
                    System.out.println("Invalid choice. Please try again.");
            }
        }
    }

    private static void manageAccount(BankAccount account) {
        Scanner sc = new Scanner(System.in);
        int choice;

        while (true) {
            System.out.println("1: Check Balance\n2: Withdraw Amount\n3: Deposit Amount\n4: Back");
            System.out.println("Enter your choice:");
            choice = sc.nextInt();

            switch (choice) {
                case 1:
                    System.out.println("Balance = " + account.checkBalance());
                    break;
                case 2:
                    account.withdraw();
                    System.out.println("Current Balance = " + account.checkBalance());
                    break;
                case 3:
                    account.deposit();
                    System.out.println("Current Balance = " + account.checkBalance());
                    break;
                case 4:
                    return;
                default:
                    System.out.println("Invalid choice. Please try again.");
            }
        }
    }
}
