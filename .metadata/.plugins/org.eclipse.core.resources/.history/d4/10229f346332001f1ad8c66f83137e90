//Write a Java program to create a class known as "BankAccount" with methods called deposit() and withdraw(). Create a subclass called SavingsAccount that overrides the withdraw() method to prevent withdrawals if the account balance falls below one hundred.
package Polymorphism;
class BankAccount{
	double balance;
	double amount;
	double deposite(double amount) {
		this.amount = amount;
		this.balance = balance + amount;
		return balance;
	}
	double withdraw(double amount) {
		this.amount = amount;
		this.balance = balance - amount;
		return balance;
	}
}
class SavingsAccount extends BankAccount{
	double withdraw(double amount) {
		if(super.balance < 100) {
		
			System.out.println("Balance below 100 cannot Transact");
		}
		else {
			super.withdraw(amount);
		}
		return super.balance;
	}
}
public class AccountCheck {

	public static void main(String[] args) {
		BankAccount acc = new BankAccount();
		SavingsAccount sav =  new SavingsAccount();
		
		acc.deposite(20000);
		System.out.println("current balance  = "+ acc.balance);
		
		acc.withdraw(10000);
		System.out.println("current balance  = "+ acc.balance);
		
		sav.withdraw(1200);
		System.out.println("current balance  = "+ acc.balance);
	}

}
