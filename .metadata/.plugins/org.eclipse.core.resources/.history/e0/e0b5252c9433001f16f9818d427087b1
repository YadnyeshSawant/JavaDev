//Write a Java program to create a class Shape with methods getArea() and getPerimeter(). Create three subclasses: Circle, Rectangle, and Triangle. Override the getArea() and getPerimeter() methods in each subclass to calculate and return the area and perimeter of the respective shapes.
package Polymorphism;
class Shape1{
	double calArea() {
		return 0;
	}
	double calPerimeter() {
		return 0;
	}
}
class Circle extends Shape1{
	double r,pi=3.14;
	Circle(double r){
		this.r =r;
	}
	double calArea() {
		return pi*r*r;
	}
	double calPerimeter() {
		return 2*pi*r;
	}
}
class Rectangle1 extends Shape1{
	int len,breadth;
	Rectangle1(int len, int breadth){
		this.len = len;
		this.breadth = breadth;
	}
	double calArea() {
		return len*breadth;
	}
	double calPerimeter() {
		return 2 * (len+breadth);
	}
}
public class AreaPerimeter {

	public static void main(String[] args) {
		Circle c = new Circle(3);
		System.out.println("Area = "+c.calArea() + "Perimeter = "+c.calPerimeter());

	}

}
