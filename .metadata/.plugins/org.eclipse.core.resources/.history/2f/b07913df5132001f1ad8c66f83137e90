package Polymorphism;
class Vehicle1{
	void drive() {
		System.out.println("Driving");
	}
}
class Car extends Vehicle1{
	void drive() {
		System.out.println("Car is Riding");
	}
}
public class Test {

	public static void main(String[] args) {
		Car c = new Car();
		Vehicle1 v = new Vehicle1();
		c.drive();
		v.drive();

	}

}
