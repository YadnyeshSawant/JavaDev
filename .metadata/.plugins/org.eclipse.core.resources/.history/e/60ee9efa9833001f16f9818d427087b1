package Polymorphism;
class BankAccount2{
	double balance;
	double amount;
	BankAccount2(double balance){
		this.balance = balance;
	}
	double deposite(double amount) {
		this.amount = amount;
		this.balance = balance + amount;
		return balance;
	}
	void withdraw(double amount) {
		this.amount = amount;
		this.balance = balance - amount;
	}
	double checkBalance() {
		return balance;
	}
}
class SavingsAccount2 extends BankAccount2{
	SavingsAccount2(double balance) {
		super(balance);
	}
	void withdraw(double amount) {
		if(super.checkBalance() > amount) {
			super.withdraw(amount);
		}
		else {
			System.out.println("Insufficient Balance");
		}
	}
}
