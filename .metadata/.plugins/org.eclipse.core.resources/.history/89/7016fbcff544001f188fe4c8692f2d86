package strings;

public class EndsWith {

	public static void main(String[] args) {
		String str = "Welcome to javatpoint";
		boolean result = str.endsWith("tpoint");
		if (result == true) {
			System.out.println("tpoint is present in the string");
		}
		else {
			System.out.println("tpoint is not  present in the string");
		}
	// checking for the case sensitivity of the method
	}

}
