package Aggregation;
class Operation{
	int square(int n) {
		return n*n;
	}
}
public class Circle {
	Operation op;
	double pi = 3.14;
	
	double area(int radius) {
		op = new Operation();
		int rsquare = op.square(radius);
		return pi*rsquare;
	}

	public static void main(String[] args) {
		Circle c1 = new Circle();
		double result = c1.area(3);
		System.out.println(result);
	}

}
