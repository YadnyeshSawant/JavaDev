//Write a Java program to create a vehicle class hierarchy. The base class should be Vehicle, with subclasses Truck, Car and Motorcycle. Each subclass should have properties such as make, model, year, and fuel type. Implement methods for calculating fuel efficiency, distance traveled, and maximum speed.
package Polymorphism;

import java.util.Scanner;

class Vehicle{
	int model,year,maxSpeed;
	String make;
	String fuelType;
	Vehicle(String make,int model, int year,String fuelType,int maxSpeed){
		this.model = model;
		this.make = make;
		this.year = year;
		this.fuelType = fuelType;
		this.maxSpeed = maxSpeed;
	}
}
class Truck extends Vehicle{
	double fuelQuantity,distanceTraveled;
	Truck(String make,int model,int year, String fuelType,int maxSpeed){
		super(make,model,year,fuelType,maxSpeed);
	}
	double fuelEfficiency(){
		return(distanceTraveled % fuelQuantity);
	}
	void distanceTraveled() {
		System.out.println("Distance Traveled = "+distanceTraveled);
	}
	
}
